# LLM（必需，三选一）
LLM_PROVIDER=openai          # openai | anthropic；DeepSeek/通义等 OpenAI 兼容服务用 openai + base_url
LLM_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=             # DeepSeek: https://api.deepseek.com；通义: https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=

# 第三方数据 API（真实数据源）
MARKET_DATA_PROVIDER=ddgs    # ddgs（DuckDuckGo 免费，默认） | serpapi
SOURCING_PLATFORM=1688       # 1688 | taobao（取决于 OneBound Key 权限）
SERPAPI_API_KEY=             # 仅 serpapi 模式需要
ONEBOUND_API_KEY=            # open.onebound.cn - 1688/淘宝货源数据
ONEBOUND_API_SECRET=
EXCHANGE_RATE_API_KEY=       # exchangerate-api.com，留空使用免费开放端点
