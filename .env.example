# LLM（必需，三选一）
LLM_PROVIDER=openai          # openai | anthropic | dashscope（用 openai + base_url）
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
OPENAI_BASE_URL=             # 通义兼容模式: https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=

# 第三方数据 API（真实数据源）
SERPAPI_API_KEY=             # serpapi.com - Amazon 竞品/市场数据
ONEBOUND_API_KEY=            # open.onebound.cn - 1688 货源数据
ONEBOUND_API_SECRET=
EXCHANGE_RATE_API_KEY=       # exchangerate-api.com，留空使用免费开放端点
